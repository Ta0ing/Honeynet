HONEYPOT_ADDR=:8080
HONEYPOT_DATABASE_DSN=honeynet:honeynet@tcp(127.0.0.1:3306)/honeynet?charset=utf8mb4&parseTime=True&loc=Local
HONEYPOT_JWT_SECRET=change-me-to-a-long-random-secret
HONEYPOT_ADMIN_USERNAME=admin
HONEYPOT_ADMIN_PASSWORD=Honeynet@123
HONEYPOT_PUBLIC_URL=http://localhost:8080
HONEYPOT_TLS_ENABLED=false
# HONEYPOT_TLS_CERT_FILE=/etc/honeynet/console/fullchain.pem
# HONEYPOT_TLS_KEY_FILE=/etc/honeynet/console/privkey.pem
HONEYPOT_WEB_DIST=web/dist
HONEYPOT_DOWNLOADS_DIR=downloads
HONEYPOT_BUILTIN_AGENT_TOKEN=replace-with-a-random-shared-token
HONEYPOT_AGENT_ADDR=:8443
HONEYPOT_AGENT_PUBLIC_URL=https://localhost:8443
HONEYPOT_AGENT_TLS_NAMES=localhost,127.0.0.1
HONEYPOT_PKI_DIR=data/pki
HONEYPOT_AGENT_CERT_VALIDITY=9600h
HONEYPOT_AGENT_RENEW_BEFORE=720h
# ClickHouse secrets normally live in the separate analytics.yaml generated by
# install-clickhouse.sh. This environment override enables an external engine.
# HONEYPOT_CLICKHOUSE_DSN=clickhouse://honeynet_app:replace-me@127.0.0.1:9000/honeynet_analytics
# HONEYPOT_ANALYTICS_CONFIG=/etc/honeynet/analytics.yaml
HONEYPOT_IPIP_DB_PATH=data/ipip.ipdb
HONEYPOT_IPIP_LANGUAGE=CN
# 免费社区威胁情报数据库；密码仅放入受保护的服务环境文件。
HONEYPOT_THREAT_INTEL_ENABLED=false
HONEYPOT_THREAT_INTEL_DB_PATH=data/threat-intelligence.db
HONEYPOT_THREAT_INTEL_DOWNLOAD_URL=
# HONEYPOT_THREAT_INTEL_ARCHIVE_PASSWORD=
HONEYPOT_THREAT_INTEL_UPDATE_INTERVAL=24h
# 可选：HONEYPOT_REDACT_SENSITIVE_EVENTS=true
HONEYPOT_CORS_ORIGINS=http://localhost:5173
