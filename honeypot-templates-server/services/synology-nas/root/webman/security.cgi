(function() {try {if (window.top == window) { return; } var top_url = window.top.location.toString(); if (window.top.location.host === window.location.host && window.top.location.protocol === window.location.protocol) { return; } if (top_url.match(/^(http[s]?:\/\/)?find.synology.com\//)) { return; }if (top_url.match(/^(http[s]?:\/\/)?gofile.me\//)) { return; }window.location = "about:blank"; } catch (e) { return; }})();
